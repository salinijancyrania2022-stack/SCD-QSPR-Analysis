# Convert to DataFrames
df_X = pd.DataFrame(X_data).set_index("Drug")
df_y = pd.DataFrame(y_data).set_index("Drug")
# Input any one property as y
X = df_X.values
y = df_y["BP"].values
# Step 1: LASSO for feature selection
lasso = LassoCV(cv=5, random_state=42)
lasso.fit(X, y)
selected_idx = np.where(lasso.coef_ != 0)[0]
selected_features = df_X.columns[selected_idx]
print("Best descriptors from LASSO:", list(selected_features))
y_pred_lasso = lasso.predict(X)
r2_lasso = r2_score(y, y_pred_lasso)
rmse_lasso = np.sqrt(mean_squared_error(y, y_pred_lasso))
mae_lasso = mean_absolute_error(y, y_pred_lasso)
r_lasso = pearsonr(y, y_pred_lasso)[0]
print("\nLASSO Regression Results:")
print(f"r: {r_lasso:.4f}")
print(f"R²: {r2_lasso:.4f}")
print(f"RMSE: {rmse_lasso:.4f}")
print(f"MAE: {mae_lasso:.4f}")
# Step 2: Ridge regression with selected descriptors from LASSO
X_selected = df_X[selected_features].values
ridge = RidgeCV(alphas=np.logspace(-3, 3, 100), cv=5)
ridge.fit(X_selected, y)
y_pred = ridge.predict(X_selected)
r2 = r2_score(y, y_pred)
rmse = np.sqrt(mean_squared_error(y, y_pred))
mae = mean_absolute_error(y, y_pred)
r = pearsonr(y, y_pred)[0]
print(f"\nRidge Regression Results:")
print(f"R²: {r2:.4f}, RMSE: {rmse:.4f}, MAE: {mae:.4f}, r: {r:.4f}")
coeffs = ridge.coef_
intercept = ridge.intercept_
ridge_eq = f"BP = {intercept:.4f} + " + " + ".join([f"({c:.4f}*{f})" for c,f in zip(coeffs, selected_features)])
print("\nRidge Equation:")
print(ridge_eq)
# Step 3: Y-Randomization with original R²
# -----------------------------
y_rand_scores = []
# Original r²
ridge_orig = RidgeCV(alphas=np.logspace(-3, 3, 1000), cv=5)
ridge_orig.fit(X_selected, y)
y_pred_orig = ridge_orig.predict(X_selected)
r2_orig = r2_score(y, y_pred_orig)
for i in range(1000):
    y_shuffled = shuffle(y, random_state=i)
    ridge_rand = RidgeCV(alphas=np.logspace(-3, 3, 1000), cv=5)
    ridge_rand.fit(X_selected, y_shuffled)
    y_pred_rand = ridge_rand.predict(X_selected)
    r2_rand = r2_score(y_shuffled, y_pred_rand)
    y_rand_scores.append(r2_rand)
print(f"\nOriginal r²: {r2_orig:.4f}")
