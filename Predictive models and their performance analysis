# Step 4:  5-Fold CV 
kf5 = KFold(n_splits=5, shuffle=True, random_state=42)
y_true_cv5 = []
y_pred_cv5 = []
for train_idx, test_idx in kf5.split(X_selected):
    X_train, X_test = X_selected[train_idx], X_selected[test_idx]
    y_train, y_test = y[train_idx], y[test_idx]
    ridge_cv = RidgeCV(alphas=np.logspace(-3, 3, 100), cv=5)
    ridge_cv.fit(X_train, y_train)
    y_pred = ridge_cv.predict(X_test)
    y_true_cv5.extend(y_test)
    y_pred_cv5.extend(y_pred)
y_true_cv5 = np.array(y_true_cv5)
y_pred_cv5 = np.array(y_pred_cv5)
r2_cv5 = r2_score(y_true_cv5, y_pred_cv5)
rmse_cv5 = np.sqrt(mean_squared_error(y_true_cv5, y_pred_cv5))
print(f"5-Fold CV r²: {r2_cv5:.4f}")
print(f"5-Fold CV RMSE: {rmse_cv5:.4f}")
